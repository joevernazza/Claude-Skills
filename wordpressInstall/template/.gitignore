# WordPress: only track our own code (theme + must-use plugin).
# Core, wp-config.php, uploads and third-party plugins/themes are installed
# per environment (Docker copies core in locally; see README).
/public_html/*
!/public_html/wp-content/
!/public_html/wp-cli.yml
/public_html/wp-content/*
!/public_html/wp-content/themes/
/public_html/wp-content/themes/*
!/public_html/wp-content/themes/__SLUG__/
!/public_html/wp-content/mu-plugins/
/public_html/wp-content/mu-plugins/*
!/public_html/wp-content/mu-plugins/__SLUG__.php
!/public_html/wp-content/mu-plugins/__SLUG__/

# Database exports from scripts/pull-db.sh
/db/
